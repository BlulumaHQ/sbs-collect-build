{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbs-collect-build",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  }
}
